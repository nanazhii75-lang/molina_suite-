#!/data/data/com.molina.suite/files/usr/bin/bash
# Pembungkus yt-dlp untuk mpv: menjalankan yt-dlp di dalam Debian (proot-distro).
# stdout hanya berisi keluaran yt-dlp agar JSON bisa di-parse oleh ytdl_hook.
# Terminal yang sudah di dalam Debian: proot-distro tidak boleh dipanggil dari sana
# (host Android tidak punya /etc/debian_version), jadi yt-dlp dijalankan langsung.
if [ -f /etc/debian_version ] && [ -x /usr/local/bin/yt-dlp ]; then
    exec /usr/local/bin/yt-dlp "$@"
fi
SELF="${0%/*}"
PREFIX="${SELF%/bin}"
export PREFIX
export HOME="${PREFIX%/usr}/home"
export TMPDIR="$PREFIX/tmp"
export PATH="$PREFIX/bin"
mkdir -p "$TMPDIR"

# Jejak singkat tiap pemanggilan di usr/var/log/mpv-ytdl.log (di dalam prefix agar terlihat
# juga dari Terminal yang berjalan di Debian/proot; dipangkas
# bila > 200 KB). Tidak menulis ke stdout: stdout dibaca ytdl_hook sebagai JSON.
LOG="$PREFIX/var/log/mpv-ytdl.log"
mkdir -p "$PREFIX/var/log" 2>/dev/null
LAST_ARG=""
for LAST_ARG in "$@"; do :; done
log_line() {
    if [ -f "$LOG" ] && [ "$(wc -c < "$LOG" 2>/dev/null || echo 0)" -gt 204800 ]; then
        tail -n 200 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG" 2>/dev/null
    fi
    printf '%s %s\n' "$(date '+%m-%d %H:%M:%S' 2>/dev/null)" "$*" >> "$LOG" 2>/dev/null
    return 0
}

# Jalur cepat YouTube: aplikasi menyelesaikan URL lewat NewPipeExtractor (tanpa proot). Hanya
# dipakai untuk "-J" (ytdl_hook) dengan URL YouTube; jawaban apa pun selain "OK" atau server yang
# tidak ada jatuh ke yt-dlp di bawah. Hentikan jalur ini dengan: touch ~/../mpv-newpipe.off
BRIDGE="${PREFIX%/usr}/mpv-newpipe.bridge"
OFF="${PREFIX%/usr}/mpv-newpipe.off"
try_newpipe() {
    local arg prev="" url="" format="" want_json=0 port token status json
    for arg in "$@"; do
        [ "$arg" = "-J" ] && want_json=1
        [ "$prev" = "--format" ] && format="$arg"
        prev="$arg"
        url="$arg"
    done
    [ "$want_json" = 1 ] || return 1
    case "$url" in
        https://youtu.be/*|https://youtube.com/*|https://www.youtube.com/*|\
        https://m.youtube.com/*|https://music.youtube.com/*) ;;
        *) return 1 ;;
    esac
    [ -e "$OFF" ] && return 1
    [ -r "$BRIDGE" ] || return 1
    read -r port token < "$BRIDGE" || return 1
    [ -n "$port" ] && [ -n "$token" ] || return 1
    exec 3<>"/dev/tcp/127.0.0.1/$port" || return 1
    printf '%s\n%s\n%s\n' "$token" "$url" "$format" >&3 || return 1
    IFS= read -r -t 45 status <&3 || return 1
    [ "$status" = "OK" ] || return 1
    IFS= read -r -t 10 json <&3 || return 1
    [ -n "$json" ] || return 1
    printf '%s\n' "$json"
}
# Dalam subshell: kegagalan membuka koneksi tidak boleh menghentikan pembungkus ini.
if json="$(try_newpipe "$@" 2>/dev/null)" && [ -n "$json" ]; then
    log_line "newpipe ok ${SECONDS}s url=$LAST_ARG"
    printf '%s\n' "$json"
    exit 0
fi

# proot-distro mencetak peringatan tak berbahaya ke stderr; buang hanya baris itu.
filter_stderr() {
    local line
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            "proot warning: can't sanitize binding"*) ;;
            *) printf '%s\n' "$line" >&2 ;;
        esac
    done
}
# stderr ditampung ke berkas lalu disaring setelah proses selesai. Substitusi proses
# (2> >(...)) dan "wait" dulu bisa menggantung selamanya karena subshell penyaring tidak
# pernah menerima EOF, sehingga pembungkus tidak selesai dan ytdl_hook mpv menunggu terus.
errfile="$TMPDIR/ytdlp-err.$$"
trap 'rm -f "$errfile"' EXIT
log_line "yt-dlp mulai url=$LAST_ARG"
proot-distro login debian --shared-tmp -- /usr/local/bin/yt-dlp "$@" </dev/null 2>"$errfile"
status=$?
log_line "yt-dlp selesai exit=$status ${SECONDS}s err=$(head -c 300 "$errfile" 2>/dev/null | tr '\n' ' ')"
if [ -s "$errfile" ]; then
    filter_stderr < "$errfile"
fi
exit "$status"
