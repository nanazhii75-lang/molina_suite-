<?xml version="1.0" encoding="utf-8"?>
<!-- molina-crash-report: layar laporan crash yang berdiri sendiri -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ms_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ms_space_md">

        <TextView
            style="@style/Molina.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crash_report_heading" />

        <TextView
            android:id="@+id/crash_report_name"
            style="@style/Molina.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ms_space_xs" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/ms_space_md"
        android:paddingEnd="@dimen/ms_space_md">

        <TextView
            android:id="@+id/crash_report_body"
            style="@style/Molina.Text.Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/ms_space_md"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/ms_space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crash_report_copy"
            style="@style/Molina.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/crash_action_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crash_report_share"
            style="@style/Molina.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/crash_action_share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crash_report_save"
            style="@style/Molina.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/crash_report_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crash_report_close"
            style="@style/Molina.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/crash_report_close" />
    </LinearLayout>
</LinearLayout>
