<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ms_bg"
    android:orientation="vertical">

    <TextView
        style="@style/Molina.Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/ms_space_md"
        android:text="@string/settings_search_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ms_space_md"
        android:paddingEnd="@dimen/ms_space_md">

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/ms_bg_card"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch|flagNoPersonalizedLearning"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:maxLength="400"
            android:maxLines="1"
            android:minHeight="48dp"
            android:padding="@dimen/ms_space_md"
            android:singleLine="true"
            android:textColor="@color/ms_text_primary"
            android:textColorHint="@color/ms_text_secondary"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/search_go"
            style="@style/Molina.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ms_space_sm"
            android:text="@string/search_button" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ms_space_md"
        android:paddingTop="@dimen/ms_space_sm"
        android:paddingEnd="@dimen/ms_space_md">

        <TextView
            android:id="@+id/search_chip_https"
            style="@style/Molina.Text.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="40dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/search_chip_safe"
            style="@style/Molina.Text.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ms_space_sm"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="40dp"
            android:gravity="center" />
    </LinearLayout>

    <TextView
        android:id="@+id/search_summary"
        style="@style/Molina.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ms_space_md"
        android:paddingTop="@dimen/ms_space_sm"
        android:paddingEnd="@dimen/ms_space_md"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/search_show_http"
        style="@style/Molina.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ms_space_sm"
        android:text="@string/search_show_http_once"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/search_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/search_message_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ms_space_md"
        android:visibility="gone">

        <TextView
            android:id="@+id/search_message"
            style="@style/Molina.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/search_retry"
            style="@style/Molina.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ms_space_sm"
            android:text="@string/search_retry"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/ms_space_sm"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/ms_space_md" />

    <TextView
        style="@style/Molina.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/ms_space_md"
        android:text="@string/search_privacy_note" />
</LinearLayout>
