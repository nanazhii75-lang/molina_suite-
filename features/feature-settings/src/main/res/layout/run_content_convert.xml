<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ms_bg_card"
        android:orientation="vertical"
        android:padding="@dimen/ms_space_md">

        <TextView
            style="@style/Molina.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/run_info_source" />

        <TextView
            android:id="@+id/conv_src_name"
            style="@style/Molina.Text.Item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ms_space_xs"
            android:ellipsize="middle"
            android:maxLines="2" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ms_card_gap"
        android:background="@drawable/ms_bg_card"
        android:orientation="vertical"
        android:padding="@dimen/ms_space_md">

        <TextView
            style="@style/Molina.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/run_info_result" />

        <TextView
            android:id="@+id/conv_out_name"
            style="@style/Molina.Text.Item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ms_space_xs"
            android:ellipsize="middle"
            android:maxLines="2" />
        <TextView
            android:id="@+id/conv_out_detail"
            style="@style/Molina.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ms_space_xs"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ms_card_gap"
        android:orientation="horizontal">

        <include
            android:id="@+id/conv_speed"
            layout="@layout/view_run_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/conv_size"
            layout="@layout/view_run_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ms_card_gap"
        android:orientation="horizontal">

        <include
            android:id="@+id/conv_eta"
            layout="@layout/view_run_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/conv_time"
            layout="@layout/view_run_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        style="@style/Molina.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ms_space_md"
        android:text="@string/run_convert_note" />
</LinearLayout>
