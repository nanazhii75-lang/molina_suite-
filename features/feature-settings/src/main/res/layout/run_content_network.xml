<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/net_ping"
        layout="@layout/view_run_metric"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ms_card_gap"
        android:orientation="horizontal">

        <include
            android:id="@+id/net_down"
            layout="@layout/view_run_metric"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/net_up"
            layout="@layout/view_run_metric"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/net_verdict"
        style="@style/Molina.Text.Item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ms_space_md"
        android:gravity="center"
        android:visibility="gone" />

    <TextView
        style="@style/Molina.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ms_space_md"
        android:text="@string/run_network_note" />
</LinearLayout>
