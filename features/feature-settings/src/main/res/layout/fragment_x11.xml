<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ms_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/ms_space_md">

        <TextView
            style="@style/Molina.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_x11_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/x11_refresh"
            style="@style/Molina.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/debian_refresh" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/ms_space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ms_space_md"
                android:layout_marginEnd="@dimen/ms_space_md"
                android:layout_marginBottom="@dimen/ms_card_gap"
                android:background="@drawable/ms_bg_card"
                android:orientation="vertical"
                android:padding="@dimen/ms_space_md">

                <TextView
                    style="@style/Molina.Text.Item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/x11_section_server" />

                <TextView
                    android:id="@+id/x11_server_status"
                    style="@style/Molina.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ms_space_xs"
                    android:text="@string/x11_status_stopped" />

                <TextView
                    android:id="@+id/x11_server_error"
                    style="@style/Molina.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ms_space_xs"
                    android:visibility="gone" />

                <TextView
                    style="@style/Molina.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ms_space_xs"
                    android:text="@string/x11_server_hint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ms_space_sm"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/x11_server_start"
                        style="@style/Molina.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/ms_card_gap_half"
                        android:layout_weight="1"
                        android:text="@string/x11_server_start" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/x11_server_stop"
                        style="@style/Molina.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ms_card_gap_half"
                        android:layout_weight="1"
                        android:text="@string/x11_server_stop" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ms_space_md"
                android:layout_marginEnd="@dimen/ms_space_md"
                android:layout_marginBottom="@dimen/ms_card_gap"
                android:background="@drawable/ms_bg_card"
                android:orientation="vertical"
                android:padding="@dimen/ms_space_md">

                <TextView
                    style="@style/Molina.Text.Item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/x11_section_desktop" />

                <TextView
                    android:id="@+id/x11_desktop_status"
                    style="@style/Molina.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ms_space_xs"
                    android:text="@string/x11_desktop_checking" />

                <TextView
                    style="@style/Molina.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ms_space_xs"
                    android:text="@string/x11_desktop_hint" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/x11_desktop_install"
                    style="@style/Molina.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ms_space_sm"
                    android:text="@string/x11_desktop_install" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ms_space_sm"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/x11_desktop_start"
                        style="@style/Molina.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/ms_card_gap_half"
                        android:layout_weight="1"
                        android:text="@string/x11_desktop_start" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/x11_desktop_stop"
                        style="@style/Molina.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ms_card_gap_half"
                        android:layout_weight="1"
                        android:text="@string/x11_desktop_stop" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ms_space_md"
                android:layout_marginEnd="@dimen/ms_space_md"
                android:layout_marginBottom="@dimen/ms_card_gap"
                android:background="@drawable/ms_bg_card"
                android:orientation="vertical"
                android:padding="@dimen/ms_space_md">

                <TextView
                    style="@style/Molina.Text.Item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/x11_section_ram" />

                <TextView
                    android:id="@+id/x11_ram_summary"
                    style="@style/Molina.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ms_space_xs"
                    android:text="@string/x11_ram_idle" />

                <TextView
                    style="@style/Molina.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ms_space_xs"
                    android:text="@string/x11_ram_hint" />

                <TextView
                    android:id="@+id/x11_stop_result"
                    style="@style/Molina.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ms_space_xs"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/x11_stop_choose"
                    style="@style/Molina.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ms_space_sm"
                    android:text="@string/x11_stop_choose" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ms_space_md"
                android:layout_marginEnd="@dimen/ms_space_md"
                android:layout_marginBottom="@dimen/ms_card_gap"
                android:background="@drawable/ms_bg_card"
                android:orientation="vertical"
                android:padding="@dimen/ms_space_md">

                <TextView
                    style="@style/Molina.Text.Item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/x11_section_auto_stop" />

                <TextView
                    android:id="@+id/x11_auto_stop_summary"
                    style="@style/Molina.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ms_space_xs"
                    android:text="@string/x11_auto_stop_off" />

                <TextView
                    style="@style/Molina.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ms_space_xs"
                    android:text="@string/x11_auto_stop_hint" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/x11_auto_stop_change"
                    style="@style/Molina.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ms_space_sm"
                    android:text="@string/x11_auto_stop_change" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
