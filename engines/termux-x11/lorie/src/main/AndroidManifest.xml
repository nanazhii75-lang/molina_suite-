<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="internalOnly">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        tools:ignore="DataExtractionRules,GoogleAppIndexingWarning">
        <activity
            android:name=".MainActivity"
            android:taskAffinity=".MainActivity"
            android:icon="@mipmap/lorie_ic_launcher"
            android:roundIcon="@mipmap/lorie_ic_launcher_round"
            android:label="@string/lorie_app_name"
            android:theme="@style/LorieAppTheme"
            android:launchMode="singleInstance"
            android:supportsPictureInPicture="true"
            android:configChanges="fontScale|orientation|screenSize|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|screenLayout|touchscreen|uiMode|smallestScreenSize|density"
            android:resizeableActivity="true"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            android:exported="false">
        </activity>
        <activity
            android:name=".MainActivity$MainActivityTagged"
            android:taskAffinity=""
            android:theme="@style/LorieAppTheme"
            android:documentLaunchMode="intoExisting"
            android:supportsPictureInPicture="true"
            android:autoRemoveFromRecents="true"
            android:configChanges="fontScale|orientation|screenSize|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|screenLayout|touchscreen|uiMode|smallestScreenSize|density"
            android:resizeableActivity="true"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            android:exported="false" />
        <activity
            android:theme="@style/Theme.AppCompat.DayNight"
            android:excludeFromRecents="true"
            android:name=".LoriePreferences"
            android:taskAffinity=".LoriePreferences"
            android:supportsPictureInPicture="false"
            android:resizeableActivity="true"
            android:exported="false">
        </activity>
	    <meta-data android:name="android.allow_multiple_resumed_activities" android:value="true" />

        <receiver android:name=".LoriePreferences$Receiver" android:exported="false" android:enabled="true">
            <intent-filter>
                <action android:name="com.molina.suite.x11.CHANGE_PREFERENCE" />
            </intent-filter>
        </receiver>

        <receiver android:name=".LorieApp$Receiver" android:exported="false" android:enabled="true">
            <intent-filter>
                <action android:name="com.molina.suite.x11.CmdEntryPoint.ACTION_START" />
                <action android:name="com.molina.suite.x11.ACTION_STOP" />
                <action android:name="com.molina.suite.x11.ACTION_PREFERENCES_CHANGED" />
                <action android:name="com.molina.suite.x11.ACTION_CUSTOM" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
